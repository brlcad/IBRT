if(NOT IBRT_BUNDLE_MANIFEST)
  return()
endif()

function(_ibrt_json_string input output)
  string(REPLACE "\\" "/" escaped "${input}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(REPLACE "\n" "\n" escaped "${escaped}")
  string(REPLACE "\r" "\r" escaped "${escaped}")
  string(REPLACE "\t" "\t" escaped "${escaped}")
  set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

set(install_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
cmake_path(NORMAL_PATH install_root OUTPUT_VARIABLE install_root)
if(NOT IS_DIRECTORY "${install_root}")
  message(FATAL_ERROR "IBRT manifest install root does not exist: ${install_root}")
endif()

set(manifest_files)
foreach(installed_file IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
  cmake_path(NORMAL_PATH installed_file OUTPUT_VARIABLE installed_file)
  cmake_path(IS_PREFIX install_root "${installed_file}" NORMALIZE inside_install_root)
  if(NOT inside_install_root)
    message(FATAL_ERROR
      "IBRT installed file is outside the manifest install root: ${installed_file}")
  endif()
  if(NOT EXISTS "${installed_file}" AND NOT IS_SYMLINK "${installed_file}")
    message(FATAL_ERROR "IBRT manifest references a missing file: ${installed_file}")
  endif()
  file(RELATIVE_PATH relative_file "${install_root}" "${installed_file}")
  cmake_path(NORMAL_PATH relative_file OUTPUT_VARIABLE relative_file)
  list(APPEND manifest_files "${relative_file}")
endforeach()
list(REMOVE_DUPLICATES manifest_files)
list(SORT manifest_files)

set(install_prefixes "${IBRT_BUNDLE_INSTALL_PREFIXES}")
list(APPEND install_prefixes "${install_root}")
list(FILTER install_prefixes EXCLUDE REGEX "^$")
list(REMOVE_DUPLICATES install_prefixes)

_ibrt_json_string("${install_root}" install_root_json)
set(manifest "{\n  \"schema\": 1,\n  \"platform\": ")
_ibrt_json_string("${IBRT_BUNDLE_PLATFORM}" platform_json)
string(APPEND manifest "${platform_json},\n  \"install_root\": ${install_root_json},\n")
string(APPEND manifest "  \"install_prefixes\": [")
set(separator "")
foreach(prefix IN LISTS install_prefixes)
  _ibrt_json_string("${prefix}" prefix_json)
  string(APPEND manifest "${separator}\n    ${prefix_json}")
  set(separator ",")
endforeach()
if(install_prefixes)
  string(APPEND manifest "\n  ")
endif()
string(APPEND manifest "],\n  \"files\": [")
set(separator "")
foreach(relative_file IN LISTS manifest_files)
  _ibrt_json_string("${relative_file}" file_json)
  string(APPEND manifest "${separator}\n    ${file_json}")
  set(separator ",")
endforeach()
if(manifest_files)
  string(APPEND manifest "\n  ")
endif()
string(APPEND manifest "]\n}\n")

get_filename_component(manifest_directory "${IBRT_BUNDLE_MANIFEST}" DIRECTORY)
file(MAKE_DIRECTORY "${manifest_directory}")
file(WRITE "${IBRT_BUNDLE_MANIFEST}.tmp" "${manifest}")
file(RENAME "${IBRT_BUNDLE_MANIFEST}.tmp" "${IBRT_BUNDLE_MANIFEST}")
message(STATUS "IBRT bundle manifest: ${IBRT_BUNDLE_MANIFEST}")
